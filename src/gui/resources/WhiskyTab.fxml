<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="470.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.WhiskyTabController">
   <children>
      <ListView id="lvwWhiskyList" fx:id="lvwWhiskyList" layoutX="50.0" layoutY="60.0" prefHeight="200.0" prefWidth="278.0" />
      <Button id="RigisterNewWhiskey" fx:id="btnRegisterNewWhisky" layoutX="123.0" layoutY="298.0" mnemonicParsing="false" onAction="#openRegistrationWindow" text="Register new whiskey" />
      <Button id="btnShowHistory" fx:id="btnShowHistory" layoutX="118.0" layoutY="339.0" mnemonicParsing="false" onAction="#showHistoryDialog" prefHeight="30.0" prefWidth="142.0" text="Show whisky histoy" />
      <TextArea id="txfWhiskyInfo" fx:id="txfWhiskyInfo" disable="true" layoutX="387.0" layoutY="60.0" prefHeight="102.0" prefWidth="342.0" />
      <TextField id="txfNumberOfBottles" fx:id="txfNumberOfBottles" layoutX="527.0" layoutY="213.0" prefHeight="26.0" prefWidth="82.0" />
      <TextField id="txfBottleSize" fx:id="txfBottleSize" layoutX="527.0" layoutY="256.0" prefHeight="26.0" prefWidth="82.0" />
      <Button id="BottleWhisky" fx:id="btnBottleWhisky" layoutX="497.0" layoutY="332.0" mnemonicParsing="false" onAction="#btnBottleWhiskyAction" prefHeight="30.0" prefWidth="142.0" text="Bottle whisky" />
      <Text layoutX="145.0" layoutY="42.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Whisky overveiw">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Text>
      <Text layoutX="527.0" layoutY="42.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Whisky info">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Text>
      <Text layoutX="387.0" layoutY="231.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Number of bottles" />
      <Text layoutX="387.0" layoutY="274.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Bottle size" />
   </children>
</AnchorPane>
